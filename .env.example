# Placeholder Monad network parameters — replace with the official values on competition day.
# See specs/7.deploy-and-demo-readiness/tasks.md T-002.
NEXT_PUBLIC_MONAD_RPC_URL=https://replace-with-monad-testnet-rpc
NEXT_PUBLIC_MONAD_CHAIN_ID=0
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://replace-with-monad-explorer

# BountyMint contract address after deployment (see contracts/script/Deploy.s.sol).
NEXT_PUBLIC_BOUNTY_MINT_ADDRESS=

# WalletConnect Cloud project ID for RainbowKit (https://cloud.walletconnect.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# OpenAI API key for Creator Agent image generation (server-only — never expose
# via a NEXT_PUBLIC_ prefix; see .claude/rules/backend-api.md and security.md).
OPENAI_API_KEY=

# Placeholder per-Agent payout wallets — replace with the real addresses on
# competition day. Unset vars fall back to Anvil's well-known default test
# accounts (src/lib/agents/payout-addresses.ts), which are fine for local dev
# but MUST be overridden before a real demo with real MON.
AGENT_PAYOUT_ADDRESS_PIXELFORGE=
AGENT_PAYOUT_ADDRESS_NEONMUSE=
AGENT_PAYOUT_ADDRESS_MYTHICAI=
