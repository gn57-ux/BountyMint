# Monad Testnet parameters (specs/PLAN.md, confirmed reachable — chain id
# 10143). If competition organizers publish different official values on the
# day, replace these (specs/7.deploy-and-demo-readiness/tasks.md T-002).
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadexplorer.com/

# BountyMint contract address after deployment (see contracts/script/Deploy.s.sol).
NEXT_PUBLIC_BOUNTY_MINT_ADDRESS=

# WalletConnect Cloud project ID for RainbowKit (https://cloud.walletconnect.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional. OpenAI API key for Creator Agent image generation (server-only —
# never expose via a NEXT_PUBLIC_ prefix; see .claude/rules/backend-api.md and
# security.md). Not a hard dependency for this demo: when unset,
# src/lib/agents/orchestrate.ts skips the OpenAI call entirely (no network
# attempt, no retry, no wait for the generation deadline) and uses the three
# pre-baked public/assets/fallback/*.png artworks instead. imageHash/salt/
# metadataURI/commitHash are still computed for real from that fallback image,
# and it still goes through real Pinata upload and real Monad Commit/Reveal
# (specs/4.commit-reveal-execution) — only the *image* is a demo placeholder,
# never the on-chain data. Set this to actually call OpenAI.
OPENAI_API_KEY=

# Placeholder per-Agent payout wallets — replace with the real addresses on
# competition day. Unset vars fall back to Anvil's well-known default test
# accounts (src/lib/agents/payout-addresses.ts), which are fine for LOCAL DEV
# ONLY. On any public network (including Monad Testnet), someone else can
# and did claim these famous addresses via EIP-7702 delegation, which broke
# awardWinner's payment during a live smoke test (2026-08-15, see
# specs/LESSONS.md) — MUST be overridden with fresh, never-used addresses
# before any real deploy.
AGENT_PAYOUT_ADDRESS_PIXELFORGE=
AGENT_PAYOUT_ADDRESS_NEONMUSE=
AGENT_PAYOUT_ADDRESS_MYTHICAI=

# executor private key — submits/reveals Creator Agent work only, never
# withdraws bounty funds (PRD §19.1/§12.5). Server-only, never in the frontend
# bundle, logs, or Git (.claude/rules/security.md).
EXECUTOR_PRIVATE_KEY=

# Pinata JWT for pinning generated images + metadata JSON to IPFS
# (https://app.pinata.cloud, pinning API). Server-only.
PINATA_JWT=

# This app's own public origin, used to build the metadata JSON's external_url
# field (docs/BountyMint-PRD.md §14). Defaults to localhost for local dev.
APP_URL=http://localhost:3000
