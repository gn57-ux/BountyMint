# Deployer private key (test wallet only, minimal funds) — never commit real values.
DEPLOYER_PRIVATE_KEY=

# Executor address allowed to call commitWork/revealWork. Defaults to the deployer if unset.
EXECUTOR_ADDRESS=

# Monad Testnet parameters (specs/PLAN.md, confirmed reachable — chain id
# 10143). If competition organizers publish different official values on the
# day, replace these (specs/7.deploy-and-demo-readiness/tasks.md T-002).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz/
MONAD_CHAIN_ID=10143
MONAD_EXPLORER_URL=https://testnet.monadexplorer.com/
